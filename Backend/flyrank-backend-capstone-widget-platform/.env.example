# ---- Database ----
DATABASE_URL=postgresql://widget_user:widget_pass@db:5432/widget_platform

# ---- App ----
APP_ENV=development

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=10

# ---- Geo enrichment (fallback chain toggles for deterministic testing) ----
# Set to "true" to force that provider to fail, so you can prove the fallback chain.
GEO_PROVIDER_A_DOWN=false
GEO_PROVIDER_B_DOWN=false

# ---- Safe side effect (email) ----
# Set to "true" to force the confirmation email to throw, proving it doesn't break the submission.
EMAIL_SHOULD_FAIL=false
